# Server Port
PORT=4000
NODE_ENV=development

# Database Connection (SQLite default for zero-config, or PostgreSQL in production)
DATABASE_URL="file:./transitops.db"

# JWT Secret & Expiry
JWT_SECRET="transitops_production_super_secret_jwt_key_2026_secure"
JWT_EXPIRES_IN="24h"

# CORS Allowlist (comma separated for multiple origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://shrey-1802.github.io"

# Logging level: error | warn | info | debug
LOG_LEVEL="info"
