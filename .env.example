# TransitOps Production Frontend Environment Variables
# In production, set this to your backend API domain (e.g. https://api.transitops.internal/api/v1)
# Or leave empty / set to /api/v1 when served behind a reverse proxy (Nginx / Cloudflare / K8s ingress)
VITE_API_BASE_URL=/api/v1

# App Environment: production | staging | development
VITE_APP_ENV=production

# Enable autonomous offline resilience store when backend API is unreachable or undergoing cold start
VITE_ENABLE_RESILIENT_FALLBACK=true
